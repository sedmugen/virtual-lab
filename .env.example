# .env.example — copy this file to .env and fill in your keys.
# Never commit the .env file itself (it is already in .gitignore).

# ── LLM Providers ────────────────────────────────────────────────────────────
# Set only the keys for the provider(s) you intend to use.
# Switch the active provider in src/virtual_lab/config.py → ACTIVE_PROVIDER

# Option A: OpenAI (official)
OPENAI_API_KEY=

# Option B: BigModel / GLM-4-Flash (free tier available)
#   Sign up at: https://open.bigmodel.cn
BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Option C: OpenRouter (proxy for many models)
#   Sign up at: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Data Integration ─────────────────────────────────────────────────────────
# Required only if running: python -m src.data_integration.main

# Materials Project — https://next-gen.materialsproject.org/api
MP_API_KEY=

# MatPortal — https://matportal.org
MATPORTAL_API_KEY=
